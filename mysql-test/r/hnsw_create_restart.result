  KEY `idx_e` (`e`) USING EXTENDED(vsql_vector.hnsw) WITH (`ef_construction` = 32, `m` = 4)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

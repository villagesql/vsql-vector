  KEY `idx_c` (`c` vsql_vector.hnsw_inner_product) USING EXTENDED(vsql_vector.hnsw),
  KEY `idx_d` (`d` vsql_vector.hnsw_l1) USING EXTENDED(vsql_vector.hnsw)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

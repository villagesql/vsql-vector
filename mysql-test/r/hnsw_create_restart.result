SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;
SET SESSION debug='+d,villagesql_custom_index_proceed';
# --- Initial state: empty ---
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
# --- CREATE TABLE with multiple SVECTOR columns and multiple inline HNSW indexes ---
CREATE TABLE t1 (
id INT PRIMARY KEY,
a SVECTOR(4) NOT NULL,
b SVECTOR(8) NOT NULL,
c SVECTOR(16) NOT NULL,
d SVECTOR(4) NOT NULL,
e SVECTOR(8) NOT NULL,
INDEX idx_a (a) USING EXTENDED(hnsw),
INDEX idx_b (b hnsw_cosine) USING EXTENDED(hnsw) WITH (M = 8, ef_construction = 64),
INDEX idx_c (c vsql_vector.hnsw_inner_product) USING EXTENDED(vsql_vector.hnsw)
) ENGINE=InnoDB;
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,
  `a` vsql_vector.SVECTOR(4) NOT NULL,
  `b` vsql_vector.SVECTOR(8) NOT NULL,
  `c` vsql_vector.SVECTOR(16) NOT NULL,
  `d` vsql_vector.SVECTOR(4) NOT NULL,
  `e` vsql_vector.SVECTOR(8) NOT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_a` (`a`) USING EXTENDED(vsql_vector.hnsw),
  KEY `idx_b` (`b` vsql_vector.hnsw_cosine) USING EXTENDED(vsql_vector.hnsw) WITH (`ef_construction` = 64, `m` = 8),
  KEY `idx_c` (`c` vsql_vector.hnsw_inner_product) USING EXTENDED(vsql_vector.hnsw)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
db_name	table_name	index_name	extension_name	extension_version	index_type_name	index_type_parameters
test	t1	idx_a	vsql_vector	0.0.1	hnsw	{}
test	t1	idx_b	vsql_vector	0.0.1	hnsw	{"M": "8", "ef_construction": "64"}
test	t1	idx_c	vsql_vector	0.0.1	hnsw	{}
table_name	index_name	key_position	column_name	extension_name	extension_version	profile_name
t1	idx_a	0	a	vsql_vector	0.0.1	hnsw_l2
t1	idx_b	0	b	vsql_vector	0.0.1	hnsw_cosine
t1	idx_c	0	c	vsql_vector	0.0.1	hnsw_inner_product
# --- CREATE INDEX: add an HNSW index on a not-yet-indexed column ---
CREATE INDEX idx_d ON t1 (d hnsw_l1) USING EXTENDED(hnsw);
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` int NOT NULL,

CREATE INDEX idx_y ON t2 (y hnsw_cosine) USING EXTENDED(hnsw) WITH (M = 16, ef_construction = 200);
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int NOT NULL,
  `x` vsql_vector.SVECTOR(4) NOT NULL,
  `y` vsql_vector.SVECTOR(4) NOT NULL,
  `z` vsql_vector.SVECTOR(4) NOT NULL,
  PRIMARY KEY (`id`),

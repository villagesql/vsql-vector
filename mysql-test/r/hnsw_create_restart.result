# --- Second table: build up HNSW indexes purely via CREATE INDEX / ALTER TABLE ADD INDEX ---
CREATE TABLE t2 (
id INT PRIMARY KEY,
x SVECTOR(4) NOT NULL,
y SVECTOR(4) NOT NULL,
z SVECTOR(4) NOT NULL
) ENGINE=InnoDB;
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int NOT NULL,
  `x` vsql_vector.SVECTOR(4) NOT NULL,
  `y` vsql_vector.SVECTOR(4) NOT NULL,
  `z` vsql_vector.SVECTOR(4) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci

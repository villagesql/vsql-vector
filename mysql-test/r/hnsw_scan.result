SET PERSIST vsql_allow_preview_extensions = ON;
SET SESSION debug='+d,villagesql_custom_index_proceed';
INSTALL EXTENSION vsql_vector;
CREATE TABLE t (
id INT PRIMARY KEY,
v SVECTOR(4) NOT NULL,
INDEX idx (v) USING EXTENDED(hnsw)
);
# Insert a few rows spread out in 4-D space.
INSERT INTO t VALUES (1, SVECTOR::FROM_STRING('[1,0,0,0]'));
INSERT INTO t VALUES (2, SVECTOR::FROM_STRING('[0,1,0,0]'));
INSERT INTO t VALUES (3, SVECTOR::FROM_STRING('[0,0,1,0]'));
INSERT INTO t VALUES (4, SVECTOR::FROM_STRING('[0,0,0,1]'));
INSERT INTO t VALUES (5, SVECTOR::FROM_STRING('[0.9,0.1,0,0]'));
# KNN query: 2 nearest to [1,0,0,0] -- id 1 (exact, distance 0) then id 5
# (distance ~0.1). This prefix is unambiguous, so its order is stable.
SELECT id
FROM t
ORDER BY L2_DISTANCE(v, SVECTOR::FROM_STRING('[1,0,0,0]'))
LIMIT 2;
id
1
5
# The 3rd nearest is one of the orthogonal unit vectors (ids 2, 3, 4),
# which are all equidistant (L2 = sqrt(2)) from the query. An approximate
# index may surface any of them -- and the specific one is not stable
# across builds -- so assert membership + distance rather than a fixed id.
SELECT id IN (2, 3, 4) AS third_is_orthogonal
FROM t
ORDER BY L2_DISTANCE(v, SVECTOR::FROM_STRING('[1,0,0,0]'))
LIMIT 1 OFFSET 2;
third_is_orthogonal
1
DROP TABLE t;
UNINSTALL EXTENSION vsql_vector;
SET SESSION debug='-d,villagesql_custom_index_proceed';
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;

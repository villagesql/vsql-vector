SET PERSIST vsql_allow_preview_extensions = ON;
INSTALL EXTENSION vsql_vector;
# === Part 1: Multi-page inserts with SVECTOR(1024) (3 records per page) ===
# Inserting 10 rows fills 4 data pages (3+3+3+1).
CREATE TABLE t_large (
id INT PRIMARY KEY,
v SVECTOR(1024) NOT NULL
) ENGINE=InnoDB;
SET @v1024 = CONCAT('[', REPEAT('1,', 1023), '1]');
INSERT INTO t_large VALUES
(1, @v1024), (2, @v1024), (3, @v1024), (4, @v1024), (5, @v1024),
(6, @v1024), (7, @v1024), (8, @v1024), (9, @v1024), (10, @v1024);
# Verify all 10 rows inserted
SELECT COUNT(*) AS total FROM t_large;
total
10
# Verify dimension on first 3 rows (page 1)
SELECT id, vector_dimension(v) AS dims FROM t_large ORDER BY id LIMIT 3;
id	dims
1	1024
2	1024
3	1024
# Verify dimension on last 3 rows (pages 3-4)
SELECT id, vector_dimension(v) AS dims FROM t_large ORDER BY id DESC LIMIT 3;
id	dims
10	1024
9	1024
8	1024
# Verify roundtrip on first and last row
SELECT id, SVECTOR::TO_STRING(v) = @v1024 AS matches
FROM t_large WHERE id IN (1, 10) ORDER BY id;
id	matches
1	1
10	1
SELECT id, SVECTOR::FROM_STRING(@v1024) = v AS matches
FROM t_large WHERE id IN (1, 10) ORDER BY id;
id	matches
1	1
10	1
DROP TABLE t_large;
# === Part 2: Maximum dimension SVECTOR(3072) (1 record per page) ===
# Inserting 5 rows each on a separate page exercises new-page allocation.
CREATE TABLE t_max (
id INT PRIMARY KEY,
v SVECTOR(3072) NOT NULL
) ENGINE=InnoDB;
# Confirm the engine-reported maximum
SELECT vector_max_dimension() AS max_dim;
max_dim
3072
SET @v3072 = CONCAT('[', REPEAT('1,', 3071), '1]');
INSERT INTO t_max VALUES
(1, @v3072), (2, @v3072), (3, @v3072), (4, @v3072), (5, @v3072);
# Verify all 5 rows inserted
SELECT COUNT(*) AS total FROM t_max;
total
5
# Verify dimension on all rows
SELECT id, vector_dimension(v) AS dims FROM t_max ORDER BY id;
id	dims
1	3072
2	3072
3	3072
4	3072
5	3072
# Verify roundtrip on first and last row
SELECT id, SVECTOR::TO_STRING(v) = @v3072 AS matches
FROM t_max WHERE id IN (1, 5) ORDER BY id;
id	matches
1	1
5	1
# === Part 2b: Delete + purge + re-insert cycle for SVECTOR(3072) ===
# Each delete frees a single-slot page; after purge that page must return
# to the free list so subsequent inserts can reuse it.  We cannot directly
# observe page reuse here, but exercising the path verifies no crash/error.
# Round 1: delete two rows, wait for purge, re-insert two rows
DELETE FROM t_max WHERE id IN (1, 2);
INSERT INTO t_max VALUES (6, @v3072), (7, @v3072);
SELECT COUNT(*) AS total FROM t_max;
total
5
SELECT id FROM t_max ORDER BY id;
id
3
4
5
6
7
# Round 2: delete all current rows, wait for purge, re-insert fresh rows
DELETE FROM t_max;
INSERT INTO t_max VALUES (11, @v3072), (12, @v3072), (13, @v3072);
SELECT COUNT(*) AS total FROM t_max;
total
3
SELECT id FROM t_max ORDER BY id;
id
11
12
13
DROP TABLE t_max;
# === Part 3: Error case - dimension 3073 exceeds MAX_VECTOR_DIMENSION (3072) ===
CREATE TABLE t_over (
id INT PRIMARY KEY,
v SVECTOR(3073) NOT NULL
) ENGINE=InnoDB;
ERROR 42000: VECTOR: Dimension 3073 exceeds maximum allowed (3072) near 'SVECTOR(3073) NOT NULL
) ENGINE=InnoDB' at line 3
# Boundary test completed
UNINSTALL EXTENSION vsql_vector;
SET PERSIST vsql_allow_preview_extensions = OFF;
RESET PERSIST vsql_allow_preview_extensions;
